classDiagram
    class PedidoController {
        +criarPedido(dto) Pedido
    }
    class FreteService {
        <<interface>>
        +calcular(pedido) Money
    }
    class PedidoRepository {
        <<interface>>
        +salvar(pedido)
    }
    class Pedido {
        -id
        -status
    }
    PedidoController --> FreteService
    PedidoController --> PedidoRepository
    PedidoRepository --> Pedido
